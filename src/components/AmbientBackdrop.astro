---
import ArchitectureArt from './ArchitectureArt.astro';
interface Props { architecture: 'kyoto' | 'philips' | 'tourette' | 'hangzhou' | 'neutral' }
const { architecture } = Astro.props;
---
<div class="ambient-backdrop" aria-hidden="true">
  <div class="ambient-wash"></div>
  {architecture !== 'neutral' && <ArchitectureArt architecture={architecture} />}
</div>
