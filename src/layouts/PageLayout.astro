---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import AmbientBackdrop from '../components/AmbientBackdrop.astro';
import { site } from '../lib/site';
interface Props { title: string; description?: string; lang?: string; image?: string; noindex?: boolean; article?: boolean; alternates?: { lang: string; url: string }[] }
const { title, description = site.description, lang = 'en', image, noindex, article, alternates } = Astro.props;
const pathname = Astro.url.pathname;
const architecture = pathname.startsWith('/publications') ? 'philips'
  : pathname.startsWith('/projects') ? 'tourette'
  : pathname.startsWith('/blog') ? 'hangzhou'
  : pathname === '/' || pathname.startsWith('/about') ? 'kyoto' : 'neutral';
---
<!doctype html>
<html lang={lang} data-architecture={architecture}>
  <head><Head title={`${title} | ${site.name}`} description={description} image={image} noindex={noindex} article={article} alternates={alternates} /></head>
  <body id="top" data-article={article ? 'true' : undefined}>
    <AmbientBackdrop architecture={architecture} />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1"><Container><slot /></Container></main>
    <Footer />
  </body>
</html>
